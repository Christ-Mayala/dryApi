[TEMPLATE]
[TEMPLATE]
NODE_ENV=development
PORT=5000
APP_NAME=DRY API
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:5000

# Auth / Sessions
# ATTENTION : si votre mot de passe contient un "#", mettez-le entre guillemets
# ("mon#mdp"), sinon dotenv coupe silencieusement tout ce qui suit le "#"
# (traité comme un commentaire) — le mot de passe réellement chargé serait
# alors plus court que celui écrit ici, et ne matcherait jamais côté formulaire.
SYSTEM_PASSWORD=replace_with_a_strong_system_password
# JWT_EXPIRE : durée de vie de l'access token.
# 15m est trop court pour une appli mobile (refresh constant, déconnexions intempestives).
# 7d est recommandé pour Trivida : assez long pour éviter les 401 silencieux,
# assez court pour limiter les risques si un token est compromis.
# Le refresh token (30j) prend le relais si l'access token expire.
JWT_EXPIRE=7d
JWT_SECRET=replace_with_a_64_character_random_secret
JWT_REFRESH_SECRET=replace_with_another_64_character_random_secret_for_refresh
JWT_SECRET_PREVIOUS=
SESSION_SECRET=replace_with_another_64_character_random_secret
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=2
LOG_REQUESTS=true

# Rate limit
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=150
RATE_LIMIT_AUTH_MULTIPLIER=100
RATE_LIMIT_ADMIN_MULTIPLIER=250
RATE_LIMIT_SKIP_AUTHENTICATED=true
RATE_LIMIT_SKIP_ADMIN=false

# Database
MONGO_URI=mongodb://127.0.0.1:27017/dryapi
MONGO_DB_PREFIX=

# Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Maintenance
PURGE_ENABLED=true
PURGE_AFTER_DAYS=14
PURGE_CRON=0 3 * * *

# Seed data
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=ChangeMe123!

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / OAuth
EMAIL_PROVIDER=mock
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# SMTP aliases
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM="DRY API <no-reply@example.com>"
FROM_EMAIL=no-reply@example.com

# External providers
RESEND_API_KEY=

# SCIM
SCIM_CONTACT_EMAIL=contact@example.com
SCIM_TIMEZONE=Africa/Brazzaville
SCIM_TZ_OFFSET_MINUTES=60
SCIM_WHATSAPP_PHONE=
SCIM_ADMIN_WHATSAPP_PHONE=
SCIM_RESERVATION_SLA_MINUTES=30
SCIM_RESERVATION_REMINDER_MINUTES=30
SCIM_REMINDER_ENABLED=true
SCIM_REMINDER_CRON=*/5 * * * *
SCIM_REMINDER_BATCH_SIZE=50
SCIM_ENABLE_EMAIL_NOTIFICATIONS=false
SCIM_ENABLE_SMS_NOTIFICATIONS=false
SCIM_ENABLE_WHATSAPP_NOTIFICATIONS=false
SCIM_ENABLE_ADMIN_WHATSAPP_NOTIFICATIONS=false
SCIM_DEFAULT_COUNTRY_CODE=+242
SCIM_TWILIO_ACCOUNT_SID=
SCIM_TWILIO_AUTH_TOKEN=
SCIM_TWILIO_SMS_FROM=
SCIM_TWILIO_WHATSAPP_FROM=

# Monitoring
VIEW_IP_SALT=replace_with_a_random_tracking_salt
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_TO=
HEALTH_MONITOR_INTERVAL_MS=60000
MONITOR_REPEAT_ALERTS=false
MONITOR_REPEAT_ALERT_MS=900000
MONITOR_DAILY_SUMMARY=true
MONITOR_DAILY_SUMMARY_MS=86400000
MONITOR_LOGS_EVERY_DAYS=3
MONITOR_LOGS_EVERY_MS=259200000
MONITOR_SUMMARY_ON_START=true
CRASH_ON_UNHANDLED_REJECTION=false
FATAL_ERROR_EXIT_DELAY_MS=3500

# --- Alertes avancées ---
# Niveaux de sévérité : critical | warning | info
ALERT_DEFAULT_SEVERITY=warning
ALERT_API_SEVERITY=warning
ALERT_PROCESS_SEVERITY=critical
# critical -> email + webhook + slack + discord
# warning  -> email + webhook
# info     -> webhook uniquement
ALERT_API_ERRORS=true
ALERT_API_CLIENT_ERRORS=false
ALERT_DEDUP_WINDOW_MS=60000
ALERT_MAX_STACK_LINES=20
ALERT_MAX_VALUE_LENGTH=1500
ALERT_MAX_PAYLOAD_LENGTH=1500
# Plage de silence (quiet hours) : format HH:MM, timezone IANA
ALERT_QUIET_START=22:00
ALERT_QUIET_END=07:00
ALERT_QUIET_TIMEZONE=Africa/Brazzaville
# Mode maintenance : désactive toutes les alertes sauf critical health-check
ALERT_MAINTENANCE_MODE=false
# Interrupteur global : false = aucun envoi externe (Telegram, email, webhooks, WhatsApp), même critical
ALERTS_ENABLED=true

# --- Push notifications (gratuit) ---
# Telegram : créer un bot avec @BotFather, puis récupérer le token et le chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp : utiliser CallMeBot (https://www.callmebot.com) — gratuit, pas de frais
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=

# --- Health monitor étendu ---
HEALTH_CHECK_API_LATENCY_MS=5000
HEALTH_CHECK_DISK_THRESHOLD_MB=500
HEALTH_CHECK_SYNC_QUEUE_THRESHOLD=1000
HEALTH_CHECK_QUEUE_ENABLED=false

# Media
MEDIA_DIR=downloads
MEDIA_VERBOSE=false
FFMPEG_PATH=
YT_COOKIE=
YT_USER_AGENT=
YTDL_NO_UPDATE=

# --- Prédications de la maison / YouTube (Pèlerin) ---
# Clé YouTube Data API v3 (Google Cloud Console). Lue UNIQUEMENT côté serveur,
# jamais exposée au mobile. Sans elle, la sync répond un message explicite
# sans planter et la source reste à l'état précédent.
YOUTUBE_API_KEY=
# Synchronisation automatique des prédications YouTube (désactivée en NODE_ENV=test)
YOUTUBE_SYNC_ENABLED=true
YOUTUBE_SYNC_CRON=0 * * * *

# --- Audio chrétien depuis YouTube (Pèlerin) ---
# Découverte AUTOMATIQUE de contenus chrétiens (louange, gospel, prédications,
# enseignements) dans la bibliothèque Audio — titres filtrés « chrétiens uniquement ».
YOUTUBE_AUDIO_SYNC_ENABLED=true
YOUTUBE_AUDIO_SYNC_CRON=0 5 * * *
# Requêtes de recherche (séparées par des virgules) — défaut : liste FR ci-dessous
YOUTUBE_AUDIO_QUERIES=louange chrétienne,musique chrétienne française,gospel chrétien,prédication chrétienne,enseignement biblique,adoration chants chrétiens,méditation chrétienne,prière chrétienne musique
# Nombre maximal de pistes YouTube conservées dans la bibliothèque Audio
YOUTUBE_AUDIO_MAX=800
# Binaire yt-dlp (OBLIGATOIRE pour l'écoute audio en arrière-plan).
# Installer : python -m pip install yt-dlp  (ou préciser un chemin ici)
YTDLP_BIN=yt-dlp

# --- Podcasts (Pèlerin) ---
# Tenant utilisé par le module (choisit la DB PelerinDB). Ne changez que si
# l'application s'appelle autrement.
APP_NAME=Pelerin

# ── Credentials Podcast Index (découverte) ──────────────────────────────
# OBLIGATOIRES pour la recherche / l'auto-découverte (gratuits sur
# podcastindex.org). Sans eux, la découverte répond 503 et le scheduler
# ignore la passe ; l'import RSS manuel reste fonctionnel.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# URL de base de l'API Podcast Index (défaut : endpoint public 1.0)
PODCASTINDEX_API_BASE=https://api.podcastindex.org/api/1.0

# ── Scheduler : synchronisation RSS des épisodes (horaire par défaut) ────
PODCAST_RSS_SYNC_ENABLED=true
PODCAST_RSS_CRON=0 * * * *

# ── Scheduler : auto-découverte Podcast Index (quotidienne par défaut) ───
PODCAST_AUTO_DISCOVER_ENABLED=true
PODCAST_AUTO_DISCOVER_CRON=0 4 * * *
PODCAST_AUTO_DISCOVER_MAX=8
# Mots-clés de recherche de l'auto-découverte (liste séparée par des virgules)
PODCAST_DISCOVERY_KEYWORDS=méditation chrétienne,enseignement biblique,prière catholique,évangile,Jésus Christ,louange chrétienne,témoignage chrétien,vie chrétienne

# ── Seed des podcasts par défaut au démarrage ────────────────────────────
# Si le catalogue externe est vide, on importe 8 flux chrétiens FR réels.
PODCAST_SEED_ENABLED=true

# ── Scoring du pipeline d'import automatique ─────────────────────────────
# Poids du score de pertinence 0-100 (défauts = spec produit). Tous sont
# optionnels : non renseignés, les valeurs par défaut s'appliquent.
PODCAST_SCORE_LANGUE=20            # langue française
PODCAST_SCORE_TITRE_CHRETIEN=25    # "chrétien" dans le titre
PODCAST_SCORE_TITRE_BIBLE=25       # "Bible" dans le titre
PODCAST_SCORE_TITRE_JESUS=25       # "Jésus" dans le titre
PODCAST_SCORE_TITRE_EVANGILE=15    # "évangile" dans le titre
PODCAST_SCORE_TITRE_PRIERE=15      # "prière" dans le titre
PODCAST_SCORE_TITRE_FOI=10         # foi / spiritualité dans le titre
PODCAST_SCORE_TITRE_MEDITATION=10  # "méditation" dans le titre
PODCAST_SCORE_DESC_EVANGILE=15     # "évangile" dans la description
PODCAST_SCORE_DESC_PRIERE=15       # "prière" dans la description
PODCAST_SCORE_DESC_CHRETIEN=10     # thématique chrétienne (description)
PODCAST_SCORE_DESC_BIBLE=10        # référence biblique (description)
PODCAST_SCORE_DESC_JESUS=10        # Jésus-Christ (description)
PODCAST_SCORE_DESC_COMMUNAUTE=10   # communauté chrétienne (description)
PODCAST_SCORE_DESC_MEDITATION=8    # méditation (description)
PODCAST_SCORE_DESC_LOUANGE=8       # louange / adoration (description)
PODCAST_SCORE_CATEGORIE=10         # catégorie religion / spiritualité
PODCAST_SCORE_RSS_VALIDE=10        # flux RSS parsé avec succès
# Seuils de décision du pipeline d'import automatique
PODCAST_SCORE_AUTO_PUBLISH=80      # score ≥ → publication automatique
PODCAST_SCORE_PENDING_MIN=50       # score ≥ → en attente de validation admin (< → rejeté)
# Bonus d'ordonnancement des résultats de la découverte Podcast Index (tri)
PODCAST_SCORE_DISCOVER_LANGUE=5    # bonus francophone
PODCAST_SCORE_DISCOVER_SPIRITUEL=3 # bonus thématique spirituelle

